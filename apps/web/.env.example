# Environnement de l'application web, en développement local.
# Copier en `apps/web/.env.local` et renseigner. Ne JAMAIS committer de valeur
# réelle : tous les `.env*` sont ignorés par git, sauf ce modèle.
#
# Pourquoi ici, et non à la racine : Next ne lit le `.env` que dans son propre
# dossier et ne remonte jamais l'arborescence. Le `.env` de la racine, lui, sert
# à la pile de production (Docker Compose, PostgreSQL, SMTP).
#
# Les deux premières valeurs sont affichées par `npx supabase start`, sous
# « API URL » et « anon key ».

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sert aux liens des emails de confirmation.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Clé service_role : SECRÈTE, serveur uniquement, elle contourne la RLS.
# `npx supabase status -o env` l'affiche sous le nom SERVICE_ROLE_KEY.
# Sans elle, la page « Choisissez un mot de passe » ne peut pas vérifier que le
# nouveau mot de passe diffère des trois derniers.
SUPABASE_SERVICE_ROLE_KEY=
