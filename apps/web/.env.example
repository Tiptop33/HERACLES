# Environnement de l'application web, en développement local.
# Copier en `apps/web/.env.local` et renseigner. Ne JAMAIS committer de valeur
# réelle : tous les `.env*` sont ignorés par git, sauf ce modèle.
#
# Pourquoi ici, et non à la racine : Next ne lit le `.env` que dans son propre
# dossier et ne remonte jamais l'arborescence. Le `.env` de la racine, lui, sert
# à la pile de production (Docker Compose, PostgreSQL, SMTP).
#
# Les deux premières valeurs sont affichées par `npx supabase start`, sous
# « API URL » et « anon key ».

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sert aux liens des emails de confirmation.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Clé service_role : SECRÈTE, serveur uniquement, elle contourne la RLS.
# `npx supabase status -o env` l'affiche sous le nom SERVICE_ROLE_KEY.
# Sans elle, la page « Choisissez un mot de passe » ne peut pas vérifier que le
# nouveau mot de passe diffère des trois derniers.
SUPABASE_SERVICE_ROLE_KEY=

# Courriels du parcours « nouveau candidat » (lien au parrain, au candidat,
# relance). Vides en local : rien ne part, et le lien s'affiche au référent.
BREVO_API_KEY=
COURRIEL_EXPEDITEUR=
COURRIEL_NOM_EXPEDITEUR=HERACLES

# La lecture du CV, qui pré-remplit la fiche du candidat (docs/lecture-du-cv.md).
# Vide en local : rien ne part, et le formulaire se remplit à la main. Chaque
# lecture se paie : ne la renseigner que pour essayer la fonction.
ANTHROPIC_API_KEY=

# Le secret de /api/relances. Laisser vide : la relance automatique est
# désactivée (docs/parrainage.md), et la route reste fermée.
RELANCE_SECRET=

# La réception des offres de France Travail (docs/france-travail.md). Vides en
# local : rien n'est reçu, et l'écran « France Travail » montre ce que la base
# contient. Les identifiants viennent de l'application déclarée sur
# francetravail.io ; le secret est celui de /api/offres/recevoir
# (`openssl rand -hex 32`). Départements : 33,40,47,64 si la ligne est vide.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_DEPARTEMENTS=
RECEPTION_OFFRES_SECRET=
