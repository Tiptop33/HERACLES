# Modèle d'environnement de la PILE DE PRODUCTION — copier en `.env` et renseigner.
# Ne JAMAIS committer de valeur réelle : `.env` est ignoré par git.
#
# Ce fichier sert à Docker Compose, à PostgreSQL et au SMTP. Il ne sert PAS au
# serveur de développement de l'application web : Next ne lit son environnement
# que dans son propre dossier et ne remonte jamais l'arborescence. Pour
# développer en local, c'est `apps/web/.env.local` — modèle dans
# `apps/web/.env.example`.

# --- Supabase ---
# Local (pile lancée par `npx supabase start`, ports définis dans supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54331
# PRODUCTION : https://api.<domaine-heracles>   (Kong, exposé sur 127.0.0.1:8100)

# Clé anon (publique) : figée dans le bundle client, protégée par la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SECRÈTE, serveur uniquement, contourne la RLS.
# Non utilisée au lot 1 — ne la renseigner que le jour où une route en a besoin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application web ---
WEB_PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
# PRODUCTION : https://<domaine-heracles>  (sert aussi aux liens des emails)

# --- PostgreSQL (production, stack Supabase auto-hébergée) ---
# La base n'est jamais exposée sur Internet : accès par le réseau Docker seul.
POSTGRES_DB=heracles
POSTGRES_PASSWORD=

# --- Emails ---
# ⚠ INDISPENSABLE en production. Depuis que l'on n'entre qu'invité (migration
# 0009), aucun email veut dire aucune entrée possible : ni invitation, ni
# réinitialisation de mot de passe. Ce n'est plus un confort.
#
# Ces valeurs-ci ne servent qu'à mémoire : c'est la pile Supabase qui envoie,
# et elle lit les siennes dans /opt/supabase-heracles/.env (voir
# infra/supabase/.env.example). En local, la boîte de test est sur
# http://localhost:54334 et rien ne part vraiment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.org
