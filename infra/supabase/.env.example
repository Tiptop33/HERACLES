# Environnement de la pile Supabase de production — à copier en `.env` dans
# /opt/supabase-heracles, puis à renseigner. Ne JAMAIS committer les valeurs.
#
# Les secrets se fabriquent sur le VPS, jamais ailleurs :
#   openssl rand -hex 32     → POSTGRES_PASSWORD, JWT_SECRET, SECRET_KEY_BASE…
# JWT_SECRET doit faire au moins 32 caractères.
#
# ANON_KEY et SERVICE_ROLE_KEY sont des JWT signés avec JWT_SECRET. Supabase
# fournit un générateur : https://supabase.com/docs/guides/self-hosting#api-keys

############ Base ############
POSTGRES_PASSWORD=
POSTGRES_DB=heracles
POSTGRES_HOST=db
POSTGRES_PORT=5432

############ Clés ############
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
VAULT_ENC_KEY=

############ Adresses publiques ############
# À remplacer par le domaine retenu (point ouvert n° 3 du cadrage).
SITE_URL=https://heracles.example.fr
API_EXTERNAL_URL=https://api.heracles.example.fr
SUPABASE_PUBLIC_URL=https://api.heracles.example.fr

# Les seules adresses vers lesquelles un lien d'email a le droit de renvoyer.
# Le motif d'invitation est indispensable : sans lui, plus personne n'entre.
ADDITIONAL_REDIRECT_URLS=https://heracles.example.fr/auth/callback,https://heracles.example.fr/invitation/**

############ Inscriptions ############
# Fermées : on n'entre qu'invité (migration 0009). C'est une seconde barrière,
# derrière celle de l'application.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=3600

############ Emails — indispensable ############
# Sans SMTP, aucune invitation ne part, donc personne ne peut entrer. Ce n'est
# plus un confort depuis que l'inscription libre est fermée.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=HERACLES
SMTP_ADMIN_EMAIL=no-reply@heracles.example.fr

MAILER_URLPATHS_CONFIRMATION=/auth/callback
MAILER_URLPATHS_RECOVERY=/auth/callback
MAILER_URLPATHS_INVITE=/auth/callback
MAILER_URLPATHS_EMAIL_CHANGE=/auth/callback

############ Studio ############
# Jamais publié sur Internet — voir la surcharge. Ces identifiants ne protègent
# qu'un accès déjà réservé au tunnel SSH.
DASHBOARD_USERNAME=heracles
DASHBOARD_PASSWORD=

STUDIO_DEFAULT_ORGANIZATION=HERACLES
STUDIO_DEFAULT_PROJECT=heracles

############ Divers ############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
PGRST_DB_SCHEMAS=public,storage,graphql_public
FUNCTIONS_VERIFY_JWT=false
IMGPROXY_ENABLE_WEBP_DETECTION=true
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
POOLER_TENANT_ID=heracles
POOLER_DB_POOL_SIZE=5
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_PROXY_PORT_TRANSACTION=6543
