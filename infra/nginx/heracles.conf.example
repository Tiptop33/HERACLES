# Nginx pour HERACLES — deux noms, deux services.
#
#   heracles.example.fr      → l'application web      (127.0.0.1:3002)
#   api.heracles.example.fr  → l'API Supabase, Kong   (127.0.0.1:8100)
#
# À copier dans /etc/nginx/sites-available/heracles, à adapter au domaine
# retenu, puis :
#
#   ln -s /etc/nginx/sites-available/heracles /etc/nginx/sites-enabled/
#   certbot --nginx -d heracles.example.fr -d api.heracles.example.fr
#   nginx -t && systemctl reload nginx
#
# MyCollabus vit sur le même VPS : ce fichier ne touche à rien d'autre que ces
# deux noms, et les ports 3002 / 8100 ne croisent pas les siens.

# ————— Rediriger le clair vers le chiffré —————
server {
    listen 80;
    listen [::]:80;
    server_name heracles.example.fr api.heracles.example.fr;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

# ————— L'application web —————
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name heracles.example.fr;

    # certbot renseigne ces quatre lignes.
    ssl_certificate     /etc/letsencrypt/live/heracles.example.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heracles.example.fr/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # HERACLES porte des CV et des parcours : rien ne doit en sortir par
    # inadvertance, ni finir dans le référent d'un autre site.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}

# ————— L'API Supabase —————
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.heracles.example.fr;

    ssl_certificate     /etc/letsencrypt/live/heracles.example.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heracles.example.fr/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Les CV passent par ici.
    client_max_body_size 50m;

    # Studio n'est pas derrière ce nom, et ne doit jamais l'être : on l'atteint
    # par un tunnel SSH. Kong l'exposerait volontiers — on le lui refuse.
    location ~ ^/(studio|project) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 120s;
    }
}
